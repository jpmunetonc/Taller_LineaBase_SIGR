{
  "name": "sigr-restaurante",
  "version": "1.0.0",
  "description": "SIGR - Sistema de Gestión de Restaurante (HTML + CSS + JS vanilla)",
  "private": true,
  "scripts": {
    "start": "python -m http.server 8080 --bind 127.0.0.1",
    "test": "npm run test:unit",
    "test:unit": "jest --runInBand",
    "test:e2e": "python \"tests/tests_aceptación.py\""
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/tests/**/*.js"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0"
  }
}
